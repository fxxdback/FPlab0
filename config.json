{
  "defaultPolicy": "default",
  "logFile": "password-generator.log",
  "policies": {
    "default": {
      "description": "Обычный пароль для сайта",
      "minimumLength": 12,
      "maximumLength": 64,
      "defaultLength": 16,
      "characterGroups": {
        "lowercase": {
          "enabled": true,
          "minimumCount": 1
        },
        "uppercase": {
          "enabled": true,
          "minimumCount": 1
        },
        "digits": {
          "enabled": true,
          "minimumCount": 1
        },
        "special": {
          "enabled": true,
          "minimumCount": 1,
          "characters": "!@#$%^&*_-+="
        }
      },
      "forbiddenCharacters": "0O1Il",
      "allowRepeatedCharacters": true,
      "maximumConsecutiveIdenticalCharacters": 2,
      "allowSpaces": false,
      "forbiddenSubstrings": [
        "password",
        "admin",
        "qwerty"
      ]
    },
    "pin": {
      "description": "Цифровой PIN-код",
      "minimumLength": 4,
      "maximumLength": 8,
      "defaultLength": 6,
      "characterGroups": {
        "lowercase": {
          "enabled": false,
          "minimumCount": 0
        },
        "uppercase": {
          "enabled": false,
          "minimumCount": 0
        },
        "digits": {
          "enabled": true,
          "minimumCount": 6
        },
        "special": {
          "enabled": false,
          "minimumCount": 0
        }
      },
      "forbiddenCharacters": "",
      "allowRepeatedCharacters": true,
      "maximumConsecutiveIdenticalCharacters": 2,
      "allowSpaces": false,
      "forbiddenSubstrings": [
        "1234",
        "0000"
      ]
    },
    "wifi": {
      "description": "Пароль для домашней сети Wi-Fi",
      "minimumLength": 16,
      "maximumLength": 32,
      "defaultLength": 20,
      "characterGroups": {
        "lowercase": {
          "enabled": true,
          "minimumCount": 4
        },
        "uppercase": {
          "enabled": true,
          "minimumCount": 2
        },
        "digits": {
          "enabled": true,
          "minimumCount": 2
        },
        "special": {
          "enabled": false,
          "minimumCount": 0
        }
      },
      "forbiddenCharacters": "0O1Il",
      "allowRepeatedCharacters": false,
      "maximumConsecutiveIdenticalCharacters": 1,
      "allowSpaces": false,
      "forbiddenSubstrings": []
    }
  }
}